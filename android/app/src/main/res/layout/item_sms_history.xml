<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Sender, Timestamp & Classification Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgBadgeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Status Icon"
                android:src="@drawable/ic_spam_warning" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_main"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="+91 98765 43210" />

                <TextView
                    android:id="@+id/txtTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    tools:text="Today, 2:45 PM" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtBadgePill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rounded_card_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="SPAM 96%"
                android:textColor="@color/color_danger"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Message Body Preview / Full -->
        <TextView
            android:id="@+id/txtMessageBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            tools:text="URGENT: CSPDCL Electricity officer notice. Your power will be cut tonight at 9:30 PM..." />

        <!-- Detected Rules / Tags -->
        <TextView
            android:id="@+id/txtRuleTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F3F4F6"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#374151"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Rules: FAKE_KYC_DISCONNECTION"
            tools:visibility="visible" />

        <!-- Feedback & Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkSafe"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mark Safe"
                android:textColor="@color/color_safe"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkSpam"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Report Spam"
                android:textColor="@color/color_danger"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
