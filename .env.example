# ==============================================================================
# Jan Suraksha — Environment Configuration Template (.env.example)
# Copy this file to .env in production or configure variables in your cloud provider
# ==============================================================================

# Server Hosting Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production

# Application Secret Key
# Used for cryptographic signing of anonymous fraud reports and update packs (Ed25519 / HMAC)
# Generate a secure 48-byte token using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SURAKSHA_REPORT_SECRET=replace_with_a_secure_random_token_here

# Database Persistence Path
# Optional: Path to SQLite database file. Useful when mounting persistent cloud disks (e.g. /var/data/suraksha.db)
SURAKSHA_DB_PATH=backend/data/suraksha.db

# Optional: Path to Speech AI Whisper Models
# If not specified, the system will use local cached models or fallback to Vosk/edge engine
# WHISPER_MEDIUM_PATH=models/whisper-medium
# WHISPER_SMALL_PATH=models/whisper-small
